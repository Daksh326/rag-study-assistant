# Copy to .env.local and fill in. Never commit .env.local.

# --- LLM (required for generated answers; without it the app shows retrieved passages only)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Database
# Leave unset for local dev: an embedded Postgres (PGlite + pgvector) is stored in .data/pglite.
# Set it for production, e.g. a Neon connection string:
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Embeddings
# Default is a free local model (bge-small-en-v1.5, 384 dims). Setting VOYAGE_API_KEY switches to
# Voyage (512 dims). The vector column size depends on this, so use a fresh database when switching.
# VOYAGE_API_KEY=
# EMBEDDINGS_PROVIDER=local

# --- Retrieval tuning (used by the evaluation experiments)
# CHUNK_TOKENS=400
# CHUNK_OVERLAP_TOKENS=60
# RETRIEVAL_MIN_SIMILARITY=0.5
